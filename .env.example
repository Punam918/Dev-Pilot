# Copy to .env, or run: python -m devpilot init --demo
# Never commit .env or your local .devpilot/ directory.
DP_PROVIDER=demo
DP_MODEL=qwen3:4b
DP_BASE_URL=http://127.0.0.1:11434/v1
DP_LLM_API_KEY=local
DP_ALLOW_REMOTE_MODEL=false
# Blank generates a private token in .devpilot/access-token.
DP_API_TOKEN=
DP_WORKSPACE_DIR=workspace
DP_DATA_DIR=.devpilot
# disabled | host-trusted (trusted fixtures) | docker | kubernetes
DP_RUNNER=disabled
DP_TRUST_LOCAL_CODE=false
DP_RUNNER_IMAGE=devpilot-runner:local
DP_DOCKER_TOOLS=false
DP_DOCKER_LABEL=devpilot.scope=demo
DP_HOST=127.0.0.1
DP_PORT=8088
DP_MAX_STEPS=24
DP_MAX_TOOL_CALLS=40
DP_MAX_CONTEXT_CHARS=90000
DP_TOOL_TIMEOUT=90
DP_LLM_TIMEOUT=120
DP_APPROVAL_TIMEOUT=300
DP_RUN_TIMEOUT=1200
DP_TEMPERATURE=0.1
DP_MAX_OUTPUT_TOKENS=2048
DP_MAX_RUNS=100

# DevOps/observability. JSON arrays are required for list settings.
DP_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]","testserver"]
DP_PUBLIC_ORIGIN=
DP_METRICS_TOKEN=
DP_OTEL_ENABLED=false
DP_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
DP_LOG_JSON=true
# Optional credential file paths: when set, they override literal token values.
# DP_API_TOKEN_FILE=.secrets/api-token
# DP_METRICS_TOKEN_FILE=.secrets/metrics-token
# Kubernetes runner requires an in-cluster service account and CA.
DP_KUBE_NAMESPACE=devpilot-runners
DP_KUBE_JOB_TIMEOUT=180
# For Kubernetes set DP_TOOL_TIMEOUT=240 (must be >= job timeout + 15).
DP_KUBE_RUNTIME_CLASS=
DP_KUBE_IMAGE_PULL_SECRET=
# Compose host port (not the app's internal port):
DP_HTTP_PORT=8088
