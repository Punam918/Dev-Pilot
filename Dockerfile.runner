# Operator-built dependencies only; repository code cannot install packages.
ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}
COPY requirements/runner.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt
COPY runner/job_entrypoint.py /opt/devpilot-job.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 HOME=/tmp
WORKDIR /workspace
USER 65534:65534
ENTRYPOINT ["python"]
