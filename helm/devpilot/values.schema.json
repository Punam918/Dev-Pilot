{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "existingSecret",
    "config",
    "runner"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "production": {
      "type": "boolean"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "runner": {
      "type": "object",
      "required": [
        "mode",
        "namespace",
        "jobTimeout"
      ],
      "properties": {
        "mode": {
          "enum": [
            "disabled",
            "kubernetes"
          ]
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
        },
        "jobTimeout": {
          "type": "integer",
          "minimum": 30,
          "maximum": 270
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "demo",
            "openai"
          ]
        },
        "allowedHosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "not": {
              "const": "*"
            }
          }
        },
        "toolTimeout": {
          "type": "integer",
          "maximum": 300,
          "minimum": 30
        }
      }
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    }
  }
}
